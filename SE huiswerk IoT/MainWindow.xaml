<Window x:Class="SE_huiswerk_IoT.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SE_huiswerk_IoT"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <StackPanel>
            <Label Content="Persoon" FontWeight="Bold" FontSize="18" />
            <Label Content="Voornaam" />
            <TextBox x:Name="FirstName" />
            <Label Content="Achternaam" />
            <TextBox x:Name="LastName" />
            <Label Content="Leeftijd" />
            <TextBox x:Name="Age" />
            <!-- Textbox voor leeftijd kan eventueel vervangen worden door
 een Slider -->
            <Button Content="Toevoegen" Click="AddPersonClicked"
Margin="0,10,0,0" />
        </StackPanel>
        <ListView Grid.Column="1" x:Name="ListViewPersons"
 SelectionChanged="PersonSelected" />
        <StackPanel Grid.Row="1">
            <Label Content="Huisdier" FontWeight="Bold" FontSize="18" />
            <Label Content="Naam" />
            <TextBox x:Name="PetName" />
            <Label Content="Soort" />
            <TextBox x:Name="PetType" />
            <Button Content="Toevoegen"
                Click="AddAnimalClicked"
                Margin="0,10,0,0" />
        </StackPanel>
        <ListView x:Name="ListViewPets" Grid.Row="1" Grid.Column="1" />
    </Grid>
</Window>
